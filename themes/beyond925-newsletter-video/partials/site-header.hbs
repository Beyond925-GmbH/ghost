<header class="site-header">
    <div class="shell header-bar">
        <div class="header-shell">
            <a class="brand" href="{{@site.url}}" aria-label="{{@site.title}} Startseite">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                {{else}}
                    <img
                        class="brand-mark"
                        src="https://media.beyond925.de/catalog/sha256/646637a9ed84156ff1d0d9860bd7686011be2289f4cfb21236cd82f21935e9ac.png"
                        alt="Beyond925"
                        width="150"
                        height="33"
                    >
                {{/if}}
            </a>
            <div class="header-actions">
                <button class="search-toggle" type="button" aria-label="Suche" data-ghost-search>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
                        <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                    </svg>
                </button>
                <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
                    <span class="menu-label">Menü</span>
                    <span class="menu-icon" aria-hidden="true"></span>
                </button>
            </div>
            <nav class="site-navigation" id="site-navigation" aria-label="Hauptnavigation">
                {{navigation}}
                {{#if @site.members_enabled}}
                    {{#unless @member}}
                        {{#unless @site.members_invite_only}}
                            <a class="nav-pill" href="#/portal/signin" data-portal="signin">Anmelden</a>
                            <a class="b925-btn b925-btn--primary b925-btn--sm" href="#/portal/signup" data-portal="signup">Abonnieren</a>
                        {{else}}
                            <a class="b925-btn b925-btn--primary b925-btn--sm" href="#/portal/signin" data-portal="signin">Anmelden</a>
                        {{/unless}}
                    {{else}}
                        <a class="b925-btn b925-btn--secondary b925-btn--sm" href="#/portal/account" data-portal="account">Konto</a>
                    {{/unless}}
                {{/if}}
            </nav>
        </div>
    </div>
</header>
