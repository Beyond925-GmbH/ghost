<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{statusCode}} — {{message}}</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 2rem;
            background: #f6f5ef;
            color: #0e1a33;
            font-family: Satoshi, system-ui, sans-serif;
            text-align: center;
        }
        h1 {
            margin: 0 0 0.75rem;
            font-family: Chillax, Satoshi, system-ui, sans-serif;
            font-size: clamp(2rem, 6vw, 3.5rem);
            letter-spacing: -0.03em;
        }
        p { color: #4a5878; margin: 0 0 1.5rem; }
        a {
            display: inline-flex;
            padding: 0.75rem 1.35rem;
            border-radius: 9999px;
            background: #2a508d;
            color: #fff;
            font-weight: 600;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div>
        <h1>{{statusCode}}</h1>
        <p>{{message}}</p>
        <a href="{{@site.url}}">Zur Startseite</a>
        {{#if errorDetails}}
            <pre style="margin-top:2rem;text-align:left;font-size:0.8rem;opacity:0.7;overflow:auto;">{{errorDetails}}</pre>
        {{/if}}
    </div>
</body>
</html>
