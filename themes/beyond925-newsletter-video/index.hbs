{{!< default}}

<section class="archive-header">
    <div class="shell-narrow">
        <span class="b925-section-label">Artikel</span>
        <h1>{{@site.title}}</h1>
        {{#if @site.description}}
            <p class="archive-lead">{{@site.description}}</p>
        {{/if}}
    </div>
</section>

<section class="posts-section shell">
    <div class="post-grid">
        {{#foreach posts}}
            {{> "post-card"}}
        {{/foreach}}
    </div>
    {{pagination}}
</section>
