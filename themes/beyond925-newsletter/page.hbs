{{!< default}}

{{#page}}
<article class="article {{post_class}}">
    {{#if @page.show_title_and_feature_image}}
    <header class="article-header">
        <div class="article-header-aura" aria-hidden="true"></div>
        <div class="article-header-inner shell-narrow">
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}<p class="article-deck">{{custom_excerpt}}</p>{{/if}}
        </div>
    </header>

    {{#if feature_image}}
        <figure class="article-feature shell-wide">
            <img
                srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w"
                sizes="(min-width: 1200px) 1120px, 92vw"
                src="{{img_url feature_image size="l"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            >
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
    {{/if}}
    {{/if}}

    <div class="gh-content shell-article">
        {{content}}
    </div>
</article>
{{/page}}
