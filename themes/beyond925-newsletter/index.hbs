{{!< default}}

<section class="home-hero" aria-labelledby="home-hero-heading">
    <div class="home-hero-aura" aria-hidden="true"></div>
    <div class="shell home-hero-inner">
        <div class="home-hero-copy reveal">
            <span class="b925-section-label">
                <span class="b925-section-label-dot" aria-hidden="true"></span>
                Azubi-Recruiting Briefing
            </span>
            <h1 id="home-hero-heading">Klarheit für bessere Recruiting-Entscheidungen.</h1>
        </div>
        <div class="home-hero-aside reveal reveal-delay-1">
            <p class="hero-lead">Analysen, Praxiswissen und Perspektiven für HR und Geschäftsführung — verständlich eingeordnet und direkt anwendbar.</p>
            <div class="hero-actions">
                {{#if @custom.consultation_url}}
                    <a class="b925-btn b925-btn--primary b925-btn--lg" href="{{@custom.consultation_url}}">Beratungsgespräch buchen</a>
                {{/if}}
                <a class="b925-btn b925-btn--tertiary" href="#artikel">Aktuelle Artikel <span aria-hidden="true">↓</span></a>
            </div>
        </div>
    </div>
</section>

<section class="posts-section shell" id="artikel">
    <div class="section-heading section-heading-split reveal">
        <div>
            <span class="b925-section-label">Aktuelle Einordnungen</span>
            <h2>Wissen, das Entscheidungen erleichtert.</h2>
        </div>
        <p>Strategie, Praxis und Perspektiven für modernes Azubi-Recruiting.</p>
    </div>

    <div class="post-grid">
        {{#foreach posts}}
            {{#if @first}}
                <a class="featured-row reveal" href="{{url}}">
                    <div class="featured-row-media">
                        {{#if feature_image}}
                            <img
                                srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w"
                                sizes="(min-width: 900px) 42vw, 100vw"
                                src="{{img_url feature_image size="l"}}"
                                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                                loading="eager"
                            >
                        {{else}}
                            <span class="image-placeholder" aria-hidden="true"></span>
                        {{/if}}
                    </div>
                    <div class="featured-row-copy">
                        <span class="b925-section-label">Aktuelle Analyse</span>
                        <h3>{{title}}</h3>
                        {{#if custom_excerpt}}
                            <p>{{custom_excerpt}}</p>
                        {{else}}
                            <p>{{excerpt words="36"}}</p>
                        {{/if}}
                        <div class="post-meta">
                            {{#primary_tag}}<span>{{name}}</span>{{/primary_tag}}
                            <span>{{reading_time minute="1 Min." minutes="% Min."}}</span>
                        </div>
                        <span class="featured-row-action">Artikel lesen <span aria-hidden="true">→</span></span>
                    </div>
                </a>
            {{else}}
                {{> "post-card"}}
            {{/if}}
        {{/foreach}}
    </div>
    {{pagination}}
</section>

{{> "editorial-portraits"}}
{{> "consultation-band"}}
