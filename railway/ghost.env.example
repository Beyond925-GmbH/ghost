# Railway Ghost service variables.
# Do not set bridge variables like HUBSPOT_ACCESS_TOKEN here.
NODE_ENV=production

# Must match the exact domain users visit (including https://). Mismatch breaks
# admin login cookies and origin checks.
url=https://news.beyond925.de

# Railway injects PORT; bind on all interfaces inside the container.
server__host=0.0.0.0
server__port=${{PORT}}

# Railway captures stdout/stderr. Avoid Ghost's production file rotation, which
# can crash the container when log file renames race or stale rotated files exist.
logging__transports=["stdout"]
logging__rotation__enabled=false

# MySQL (use Railway reference syntax)
database__client=mysql
database__connection__host=${{MySQL.MYSQLHOST}}
database__connection__port=${{MySQL.MYSQLPORT}}
database__connection__user=${{MySQL.MYSQLUSER}}
database__connection__password=${{MySQL.MYSQLPASSWORD}}
database__connection__database=${{MySQL.MYSQLDATABASE}}

# Bulk newsletters via Resend
bulkEmail__provider=resend
bulkEmail__resend__apiKey=${{RESEND_API_KEY}}

# Transactional mail (login codes, password reset, staff device verification).
# Outbound SMTP requires Railway Pro+; redeploy after upgrading plans.
# mail__from must use a domain verified in Resend (see docs/resend-dns.md).
mail__transport=SMTP
mail__options__host=smtp.resend.com
mail__options__port=465
mail__options__secure=true
mail__options__auth__user=resend
mail__options__auth__pass=${{RESEND_API_KEY}}
mail__from=Team beyond925 <newsletter@beyond925.de>

# While Railway SMTP is blocked (Hobby) or unreliable, disable staff device
# verification so login does not await email. Re-enable once mail works on Pro+.
security__staffDeviceVerification=false

# Allow Ghost webhooks to target the bridge on Railway private mesh
# (http://hsbridge.railway.internal:8080/webhooks/ghost/member-added)
security__allowWebhookInternalIPs=true

# Image/media/file storage on a Railway Bucket (S3-compatible). Stores uploads in
# external object storage so they survive any Railway volume wipe/recreate. The
# `s3` adapter ships in the image (see railway/README.md "Image storage (Railway Bucket)").
#
# Replace `Bucket` below with your Bucket service's name and wire these as Railway
# variable references so credential rotations propagate automatically.
storage__active=s3
storage__media=s3
storage__files=s3
storage__s3__accessKeyId=${{Bucket.ACCESS_KEY_ID}}
storage__s3__secretAccessKey=${{Bucket.SECRET_ACCESS_KEY}}
storage__s3__region=${{Bucket.REGION}}
storage__s3__bucket=${{Bucket.BUCKET}}
storage__s3__endpoint=${{Bucket.ENDPOINT}}
# Railway Buckets use virtual-hosted-style URLs, so path-style must be OFF.
storage__s3__forcePathStyle=false
storage__s3__acl=
# Public URL prefix returned after upload. Without this, the S3 adapter falls back to
# https://s3-<region>.amazonaws.com/<bucket>/... which breaks on Railway/Tigris.
#
# Simplest option (no extra service): point at Ghost's own /content/images route.
# Ghost proxies reads from the private bucket via the adapter's serve() middleware.
storage__s3__assetHost=https://news.beyond925.de/content/images
#
# Alternative: deploy Railway's "Public Bucket URLs" presigner and use its domain
# here instead (offloads image egress from the Ghost container).

# Secret to add in Railway (not committed):
# RESEND_API_KEY=re_...
#
# Bucket credentials are injected via the ${{Bucket.*}} references above; no extra
# secrets needed. (Any S3-compatible store works here too, e.g. Cloudflare R2.)
