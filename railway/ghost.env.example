# Railway Ghost service variables.
# Do not set bridge variables like HUBSPOT_ACCESS_TOKEN here.
NODE_ENV=production

# Must match the exact domain users visit (including https://). Mismatch breaks
# admin login cookies and origin checks.
url=https://news.beyond925.de

# Railway injects PORT; bind on all interfaces inside the container.
server__host=0.0.0.0
server__port=${{PORT}}

# Railway captures stdout/stderr. Avoid Ghost's production file rotation, which
# can crash the container when log file renames race or stale rotated files exist.
logging__transports=["stdout"]
logging__rotation__enabled=false

# MySQL (use Railway reference syntax)
database__client=mysql
database__connection__host=${{MySQL.MYSQLHOST}}
database__connection__port=${{MySQL.MYSQLPORT}}
database__connection__user=${{MySQL.MYSQLUSER}}
database__connection__password=${{MySQL.MYSQLPASSWORD}}
database__connection__database=${{MySQL.MYSQLDATABASE}}

# Bulk newsletters via Resend
bulkEmail__provider=resend
bulkEmail__resend__apiKey=${{RESEND_API_KEY}}

# Transactional mail (login codes, password reset, staff device verification).
# Outbound SMTP requires Railway Pro+; redeploy after upgrading plans.
# mail__from must use a domain verified in Resend (see docs/resend-dns.md).
mail__transport=SMTP
mail__options__host=smtp.resend.com
mail__options__port=465
mail__options__secure=true
mail__options__auth__user=resend
mail__options__auth__pass=${{RESEND_API_KEY}}
mail__from=Team beyond925 <newsletter@beyond925.de>

# While Railway SMTP is blocked (Hobby) or unreliable, disable staff device
# verification so login does not await email. Re-enable once mail works on Pro+.
security__staffDeviceVerification=false

# Secret to add in Railway (not committed):
# RESEND_API_KEY=re_...
